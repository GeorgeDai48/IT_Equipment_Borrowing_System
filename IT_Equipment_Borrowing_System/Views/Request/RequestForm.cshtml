@using IT_Equipment_Borrowing_System.Models;
@model Request

<h1>Equipment Request Form</h1>
<form method="post" asp-action="RequestForm" asp-controller="Request">
    <label asp-for="Name"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>

    <label asp-for="Email"></label>
    <input asp-for="Email" class="form-control" />
    <span asp-validation-for="Email" class="text-danger"></span>

    <label asp-for="PhoneNumber">Phone Number</label>
    <input asp-for="PhoneNumber" class="form-control" />
    <span asp-validation-for="PhoneNumber" class="text-danger"></span>

    <label asp-for="RequestDetails"> Request Details</label>
    <input asp-for="RequestDetails" class="form-control" />
    <span asp-validation-for="RequestDetails" class="text-danger"></span>

    <label asp-for="Duration"> Duration (in days)</label>
    <input asp-for="Duration" class="form-control" />
    <span asp-validation-for="Duration" class="text-danger"></span>

    <label asp-for="Role"></label>
    <select asp-for="Role" class="form-control" asp-items="Html.GetEnumSelectList<Role>()">
        <option value="">Select a Role</option>
    </select>
    <span asp-validation-for="Role" class="text-danger"></span>

    <label asp-for="EquipmentType">Equipment Type</label>
    <select asp-for="EquipmentType" class="form-control" asp-items="Html.GetEnumSelectList<EquipmentType>()">
        <option value="">Select an Equipment Type</option>
    </select>
    <span asp-validation-for="EquipmentType" class="text-danger"></span>

    <button type="submit" class="btn btn-primary">Submit</button>
</form>
