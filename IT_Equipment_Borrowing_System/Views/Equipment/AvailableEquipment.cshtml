@using IT_Equipment_Borrowing_System.Models
@model IEnumerable<Equipment>

<h1>All Available Equipment</h1>
<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Type</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.Id</td>
                    <td>@e.Name</td>
                    <td>@e.Type</td>
                    <td>@e.Description</td>

                </tr>
            }
        </tbody>
    </table>
</div>