@using IT_Equipment_Borrowing_System.Models
@model IEnumerable<Equipment>

<h1>All Equipment</h1>
<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Type</th>
                <th>Description</th>
                <th>Availablility</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
                {
                <tr>
                    <td>@e.Id</td>
                    <td>@e.Name</td>
                    <td>@e.Type</td>
                    <td>@e.Description</td>
                    <td>@e.IsAvailable</td>
                </tr>
                }
            </tbody>
        </table>
    </div>